# Copy to .env for local dev — on Render, set these in the service Environment tab.

PORT=8787

# SendGrid → Settings → API Keys → Create (Restricted: Mail Send only)
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxx

# Must be a verified sender in SendGrid (single sender or domain-authenticated address)
SENDGRID_FROM_EMAIL=contact@thesquadinstitute.com
SENDGRID_FROM_NAME=Squad Institute

# Where applications and contact messages land (your inbox)
CONTACT_TO_EMAIL=contact@thesquadinstitute.com

# Comma-separated origins allowed to POST (include Render preview + prod domains)
ALLOWED_ORIGINS=https://thesquadinstitute.com,https://www.thesquadinstitute.com,https://squad-institute-website.onrender.com,http://localhost:3000,http://localhost:8787

# Set to "true" to send applicants a receipt email (optional)
SEND_APPLICANT_RECEIPT=true
